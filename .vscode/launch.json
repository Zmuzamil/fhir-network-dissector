{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Dissect lab PCAP",
      "type": "debugpy",
      "request": "launch",
      "module": "fhir_dissector",
      "args": [
        "pcap",
        "captures/lab.pcap",
        "-o",
        "captures/events.jsonl"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Live capture (needs admin)",
      "type": "debugpy",
      "request": "launch",
      "module": "fhir_dissector",
      "args": [
        "live",
        "--bpf",
        "tcp port 8080"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Mock FHIR server",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/lab/mock_fhir_server.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Generate traffic",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/lab/gen_traffic.py",
      "args": [
        "--base",
        "http://localhost:8080/fhir",
        "--out",
        "captures/expected.json"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Evaluate",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/lab/evaluate.py",
      "args": [
        "--pcap",
        "captures/lab.pcap",
        "--expected",
        "captures/expected.json"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
