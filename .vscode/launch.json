{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Network lab: run icu (60 s)",
      "type": "debugpy",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "program": "${workspaceFolder}/netlab/labctl.py",
      "args": [
        "run",
        "icu",
        "--duration",
        "60"
      ]
    },
    {
      "name": "Dissect a network-lab capture",
      "type": "debugpy",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "module": "fhir_dissector",
      "args": [
        "pcap",
        "captures/netlab/general.pcap",
        "--all",
        "-o",
        "captures/events.jsonl"
      ]
    },
    {
      "name": "Evaluate a network-lab capture",
      "type": "debugpy",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "program": "${workspaceFolder}/lab/evaluate.py",
      "args": [
        "--pcap",
        "captures/netlab/general.pcap",
        "--expected",
        "captures/netlab/general_expected.jsonl"
      ]
    },
    {
      "name": "Show a node config",
      "type": "debugpy",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "program": "${workspaceFolder}/netlab/fhir_node.py",
      "args": [
        "--node",
        "netlab/scenari/general/ehr.ini",
        "--show"
      ]
    },
    {
      "name": "Debug current test file",
      "type": "debugpy",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "module": "pytest",
      "args": [
        "${file}",
        "-q"
      ],
      "justMyCode": false
    }
  ]
}
