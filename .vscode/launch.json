{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Live test (1 click, debuggable)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/lab/live_demo.py",
      "args": [
        "all"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Dissect recorded PCAP",
      "type": "debugpy",
      "request": "launch",
      "module": "fhir_dissector",
      "args": [
        "pcap",
        "captures/pcaps/fhir_hapi.pcap",
        "-o",
        "captures/events.jsonl"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Evaluate recorded PCAP",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/lab/evaluate.py",
      "args": [
        "--pcap",
        "captures/pcaps/fhir_hapi.pcap",
        "--expected",
        "captures/pcaps/fhir_hapi_expected.json"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Mock FHIR server",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/lab/mock_fhir_server.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
