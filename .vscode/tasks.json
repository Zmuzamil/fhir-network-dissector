{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Network lab: all scenarios (5 min each)",
      "detail": "Ctrl+Shift+B: build the hospital network, capture every scenario, evaluate (~25 min)",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": [],
      "args": [
        "netlab/labctl.py",
        "generate",
        "--duration",
        "300"
      ],
      "group": {
        "kind": "build"
      }
    },
    {
      "label": "Network lab: quick run (60 s each)",
      "detail": "Ctrl+Shift+B: same with 60 s per scenario (~10 min)",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": [],
      "args": [
        "netlab/labctl.py",
        "generate",
        "--duration",
        "60"
      ],
      "group": {
        "kind": "build"
      }
    },
    {
      "label": "Network lab: evaluate captures",
      "detail": "Re-evaluate captures/netlab/*.pcap and write summary.txt",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": [],
      "args": [
        "netlab/labctl.py",
        "evaluate"
      ]
    },
    {
      "label": "Network lab: stop (down)",
      "detail": "Stop containers and networks, merge answer keys (safe after an interrupted run)",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": [],
      "args": [
        "netlab/labctl.py",
        "down"
      ]
    },
    {
      "label": "Run unit tests",
      "detail": "pytest (no Docker, no network, no admin)",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": [],
      "args": [
        "-m",
        "pytest",
        "-q"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    }
  ]
}
