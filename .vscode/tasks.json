{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Test EVERYTHING (1 click, quick)",
      "detail": "Ctrl+Shift+B: Docker + unit tests + 4 scenarios x 60 s + verdict (~12 min)",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": [],
      "args": [
        "netlab/labctl.py",
        "all",
        "--duration",
        "60"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Test EVERYTHING (full, 5 min per scenario)",
      "detail": "Docker + unit tests + 4 scenarios x 5 min + verdict (~30 min)",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": [],
      "args": [
        "netlab/labctl.py",
        "all",
        "--duration",
        "300"
      ]
    },
    {
      "label": "Network lab: evaluate captures",
      "detail": "Re-evaluate captures/netlab/*.pcap and write summary.txt",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": [],
      "args": [
        "netlab/labctl.py",
        "evaluate"
      ]
    },
    {
      "label": "Network lab: stop (down)",
      "detail": "Stop containers and networks (safe after an interrupted run)",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": [],
      "args": [
        "netlab/labctl.py",
        "down"
      ]
    },
    {
      "label": "Run unit tests",
      "detail": "pytest only (no Docker)",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": [],
      "args": [
        "-m",
        "pytest",
        "-q"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    }
  ]
}
