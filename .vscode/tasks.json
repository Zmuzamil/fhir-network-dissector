{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run everything (1 click)",
      "detail": "Ctrl+Shift+B: starts Docker + HAPI if needed, then the live test with grade",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": [],
      "args": [
        "lab/live_demo.py",
        "all"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Live test only",
      "detail": "Server must already run: live dissector + 19 calls + grade",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": [],
      "args": [
        "lab/live_demo.py",
        "run"
      ]
    },
    {
      "label": "Record PCAP",
      "detail": "Records the 19 calls into captures/pcaps/ (pcap + answer key + score)",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": [],
      "args": [
        "lab/live_demo.py",
        "record"
      ]
    },
    {
      "label": "Start FHIR server",
      "detail": "Starts HAPI (8080, or 8090 if busy) and waits until ready",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": [],
      "args": [
        "lab/live_demo.py",
        "start"
      ]
    },
    {
      "label": "Stop FHIR server",
      "detail": "Stops the HAPI container",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": [],
      "args": [
        "lab/live_demo.py",
        "stop"
      ]
    }
  ]
}
