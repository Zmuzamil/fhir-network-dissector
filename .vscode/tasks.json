{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1 Start FHIR server",
      "detail": "Starts HAPI in Docker (port 8080, or 8090 if busy) and waits until it is ready",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["lab/live_demo.py", "start"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "2 Run live test",
      "detail": "Live dissector + 19 FHIR calls + grade (shortcut: Ctrl+Shift+B)",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["lab/live_demo.py", "run"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Stop FHIR server",
      "detail": "Stops the HAPI container",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["lab/live_demo.py", "stop"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    }
  ]
}
